# Copy to .env (git-ignored) or set these in your environment. Nothing here is ever committed.

# deadlock-api.com API key (optional; raises rate limits). Format: dlk_live_...
#DEADLOCK_API_KEY=

# Steam login for the Game Coordinator replay-salt helper. Only needed to run `deaddemo gc login`
# non-interactively; the GUI prompts for these instead and never writes them to disk.
#DEADDEMO_STEAM_USER=
#DEADDEMO_STEAM_PASSWORD=
# One-time Steam Guard code (mobile authenticator / email) for the login step.
#DEADDEMO_STEAM_GUARD_CODE=

# Path to the deaddemo-gc helper binary if it is not next to the app or in gc/target/release.
#DEADDEMO_GC_BINARY=
